# LiveKit configuration (same as your existing livekit-voice-agent)
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# OpenAI API key (for Realtime API)
OPENAI_API_KEY=<your_openai_api_key>

# Google Calendar OAuth2 credentials
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REFRESH_TOKEN=<your_google_refresh_token>

# PostgreSQL connection string
DATABASE_URL=postgresql://habits:habits@localhost:5432/habits

# SIP configuration (for phone call reminders)
# Outbound trunk ID — routes through Twilio via LiveKit SIP
LIVEKIT_SIP_TRUNK_ID=<your_sip_trunk_id>
